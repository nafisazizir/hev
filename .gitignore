# python
__pycache__/
*.pyc
.venv/
.pytest_cache/
*.egg-info/
dist/
build/
.env
.env.*
!.env.example

# training outputs (each run is a directory; keep results ledgers, not weights)
runs/*/*
!runs/*/result.json
!runs/.gitkeep
*.safetensors
*.pt
*.bin

# training partitions too large for git: fetched from the pinned Hub mirror and checksummed on use
evals/*/train.jsonl
!evals/decision-v2/train.jsonl
!evals/smoke-v1/train.jsonl
!evals/transfer-v2/train.jsonl
!evals/transfer-v4/train.jsonl

# hf / datasets caches
.cache/
hf_cache/

# scratch
.ideas/*.png
.DS_Store
